# =============================================================================
# ai-localization-demo — environment template
# Copy to .env (never commit) and fill in real values.
# =============================================================================

# Provider selection: openai | anthropic | ollama | mock
LOCALIZATION_PROVIDER=mock

# OpenAI (only required if LOCALIZATION_PROVIDER=openai)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (only required if LOCALIZATION_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Ollama (only required if LOCALIZATION_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Rate limiting (per-IP, per-minute)
RATE_LIMIT_PER_MINUTE=60