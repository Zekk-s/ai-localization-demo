# Copy to .env in the directory you start uvicorn from (backend/ when you run
# `uvicorn app.main:app` there). backend/app/config.py reads these names.
# .env is gitignored. The keys below are placeholders.

# openai | anthropic | ollama | mock
# Code default is mock. mock_provider.py does not call an external API.
LOCALIZATION_PROVIDER=mock

# Used by backend/app/translate/providers/openai_provider.py
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Used by backend/app/translate/providers/anthropic_provider.py
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Used by backend/app/translate/providers/ollama_provider.py
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Stored on Settings. The app does not bind a socket with HOST or PORT.
HOST=0.0.0.0
PORT=8000

# Exception handler in backend/app/main.py includes exception text when this is debug.
# It does not configure a logging library.
LOG_LEVEL=info

# JSON array. pydantic-settings rejects a bare URL for this field.
CORS_ORIGINS=["http://localhost:5173"]

# slowapi default limit, per client address, per minute.
RATE_LIMIT_PER_MINUTE=60

# Not Settings fields:
# APP_VERSION is read in backend/app/main.py (default 0.1.0).
# SMOKE_BASE_URL is read in scripts/smoke.py (default http://localhost:8000).
